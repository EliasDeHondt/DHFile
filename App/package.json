{
  "name": "dhfile",
  "productName": "DHFile",
  "version": "1.0.0",
  "description": "DHFile, a modern tabbed file explorer for Windows, by Elias De Hondt.",
  "author": "Elias De Hondt",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "ng build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "ng build --watch --configuration development",
    "dist": "npm run build && electron-builder --win",
    "test": "npm run build:main && node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/node": "^22.20.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3"
  }
}
